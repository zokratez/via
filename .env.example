# Anthropic API
# Used by /api/coach (Bukowski chat) and /api/cron/draft-articles
# (PubMed → diario draft generator). Get a key from console.anthropic.com.
ANTHROPIC_API_KEY=

# Supabase
# Public values are safe to expose to the browser. The service-role key is
# server-only and must stay in Vercel env vars / local .env files only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe subscriptions
# Monthly is $9.99/mo. Annual is $79/yr. Both are used by Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_VIA_PRO=
STRIPE_PRICE_ID_VIA_PRO_ANNUAL=

# Email reminders
# Used by /api/cron/send-reminders. Newsletter capture only stores email
# in Supabase; reminders use Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry
# Set this in Vercel after creating a Sentry project. The SDK no-ops
# gracefully when SENTRY_DSN is unset, so the app builds and runs
# without it — you just won't capture errors.
SENTRY_DSN=

# Rate limiting (Upstash Redis)
# Required by src/lib/rate-limit.ts (the coach route's per-user 30/hour
# rate limit). The module throws at load time if either is unset, so
# /api/coach will 500 without these. Pull from Vercel with:
#   vercel env pull .env.local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron auth (Vercel cron jobs)
# Required by /api/cron/scrape-pubmed and any future cron handler.
# Vercel auto-injects this as `Authorization: Bearer <secret>` on
# scheduled invocations when set in Project → Settings → Environment
# Variables. Generate a strong secret locally:
#   openssl rand -hex 32
# Then add it to Vercel Production (and Preview if testing) env vars.
CRON_SECRET=

# Optional emergency admin fallback
# Prefer public.admin_users in Supabase. Only set this temporarily if the
# service-role admin gate is unavailable and you need break-glass access.
# Comma-separated, e.g. admin@pacopeptide.com,sam@pacopeptide.com
ADMIN_FALLBACK_EMAILS=

# GitHub PAT (publish cron)
# Required by /api/cron/publish-drafts to write approved article
# drafts back to the zokratez/via repo via the GitHub Git Data API.
# Needs `repo` scope (or fine-grained token: Contents=read/write on
# zokratez/via). Set in Vercel Production with Sensitive=ON. Generate
# at https://github.com/settings/tokens.
GITHUB_PAT=
